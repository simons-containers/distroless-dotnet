{
  "gcc": {
    "version": "16.2.0",
    "purl": "pkg:generic/gcc",
    "source": {
      "url_pattern": "https://ftp.gnu.org/gnu/gcc/gcc-{version}/gcc-{version}.tar.xz"
    }
  },
  "zlib": {
    "version": "1.3.2",
    "purl": "pkg:generic/zlib",
    "source": {
      "url_pattern": "https://zlib.net/zlib-{version}.tar.gz"
    }
  },
  "openssl": {
    "version": "3.6.4",
    "purl": "pkg:generic/openssl",
    "source": {
      "url_pattern": "https://www.openssl.org/source/openssl-{version}.tar.gz"
    }
  },
  "libunwind": {
    "version": "1.8.3",
    "purl": "pkg:generic/libunwind",
    "source": {
      "url_pattern": "https://github.com/libunwind/libunwind/releases/download/v{version}/libunwind-{version}.tar.gz"
    }
  },
  "icu": {
    "version": "78.3",
    "purl": "pkg:generic/icu",
    "source": {
      "url_pattern": "https://github.com/unicode-org/icu/releases/download/release-{version}/icu4c-{version}-sources.tgz"
    }
  },
  "dotnet": {
    "version": "10.0.11",
    "purl": "pkg:generic/dotnet",
    "release": {
      "url_pattern": "https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/{version}/aspnetcore-runtime-{version}-linux-x64.tar.gz"
    }
  }
}
